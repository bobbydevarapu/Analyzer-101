# SendGrid Configuration
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Email address used as sender (must be verified in SendGrid)
FROM_EMAIL=your_email@gmail.com

# Admin Panel Credentials
ADMIN_USER=admin
ADMIN_PASS=your_secure_admin_password

# Admin authentication token (can be any random string)
ADMIN_TOKEN=your_random_admin_token

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/database_name
# For local MongoDB: mongodb://localhost:27017/database_name
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/assignment_analyzer?retryWrites=true&w=majority&appName=Cluster0

# Tesseract OCR Command (for OCR processing)
# On Linux/Docker: /usr/bin/tesseract
# On Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
